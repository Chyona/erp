# 数据库隐私配置（复制为 .env 后填写，勿提交 Git）
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_DBNAME=erp
DATABASE_PASSWORD=change-me

# 腾讯云 COS（可选；不填则对象存储相关能力不可用）
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET_NAME=your-bucket-name
COS_REGION=ap-guangzhou

# ── OpenAI 兼容大模型 ──────────────────────────────────────────────────────
# DashScope / 其它 OpenAI 兼容接口的 API Key
APP_LLM_API_KEY=sk-xxxxxx
# Chat Completions 基础地址（可选，默认 https://dashscope.aliyuncs.com/compatible-mode/v1）
APP_LLM_BASE_URL=
# 默认模型（AI 切片等；可选，默认 qwen3.7-plus）
APP_LLM_MODEL=qwen3.7-max

# 登录 JWT（可选；生产请改为随机长密钥）
APP_AUTH_JWT_SECRET=erp-dev-jwt-secret-change-me
APP_AUTH_EXPIRE_HOURS=72
