# 数据库隐私配置（变量名与程序 APP_* 一致，复制为 .env 后填写，勿提交 Git）
APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=5432
APP_DATABASE_USER=postgres
APP_DATABASE_DBNAME=erp
APP_DATABASE_PASSWORD=change-me

# 腾讯云 COS（可选；不填则对象存储相关能力不可用）
APP_STORAGE_COS_SECRET_ID=your-cos-secret-id
APP_STORAGE_COS_SECRET_KEY=your-cos-secret-key
APP_STORAGE_COS_BUCKET_NAME=your-bucket-name
APP_STORAGE_COS_REGION=ap-guangzhou
