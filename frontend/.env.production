# 生产构建配置（提交到 Git）
# CI / pnpm build 主要读本文件；勿写代理地址、内网 IP、密钥
#
# 不含 VITE_PROXY_TARGET：生产不走 Vite 开发代理
# 不含 VITE_USE_MOCK：未配置时默认为关闭 Mock

# —— 系统信息（可公开）——
VITE_APP_NAME=记账电子凭证系统
VITE_APP_SHORT_NAME=电子凭证
VITE_APP_DESCRIPTION=中小企业记账与凭证管理
VITE_APP_FOOTER=数据存于服务端 · ERP API

# —— API 路径（相对路径，由网关/Nginx 反代到后端）——
VITE_API_BASE_URL=/openapi/erp/v1
