# 复制为 .env 后按需修改（.env 勿提交 Git，仅本机开发用）
#
# 加载规则（Vite，文件不存在则跳过、不报错）：
#   pnpm dev   → mode=development，读本机 .env（可含代理、Mock）
#   pnpm build → mode=production，读仓库内 .env.production
#                   （CI/打包机通常没有 .env；若本机也有 .env，会先读再被
#                    .env.production 同名项覆盖）

# —— 系统信息（可公开；打包以 .env.production 为准）——
VITE_APP_NAME=记账电子凭证系统
VITE_APP_SHORT_NAME=电子凭证
VITE_APP_DESCRIPTION=中小企业记账与凭证管理
VITE_APP_FOOTER=数据存于服务端 · ERP API

# —— API 路径（开发可相对路径走 Vite 代理）——
VITE_API_BASE_URL=/openapi/erp/v1

# —— 仅本地开发（不要写进 .env.production）——
# 开发代理目标；生产由 Nginx/网关反代，不需要此项
VITE_PROXY_TARGET=http://127.0.0.1:30000
# true=不连后端，用 mock/ 内存接口；联调后端时保持 false
VITE_USE_MOCK=false
